# ==============================================================================
# ClassBank Environment Configuration Template
# Duplicate this file to '.env' for local development
# For Vercel: Set these in Project Settings -> Environment Variables
# ==============================================================================

# Supabase Project URL (From Supabase Dashboard -> Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Public Anon Key (From Supabase Dashboard -> Project Settings -> API)
# Safe for frontend - guarded by Postgres Row Level Security (RLS)
VITE_SUPABASE_ANON_KEY=your_supabase_anon_public_key

# Supabase Service Role Secret Key (CRITICAL SECRET! NEVER prefix with VITE_!)
# Never expose to the browser! Used ONLY by Serverless Functions (/api/users.mjs)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key

# Port for local admin API server (runs on port 3001 in dev)
ADMIN_API_PORT=3001

# (Optional) OpenRouter API Key for AI chatbot
OPENROUTER_API_KEY=
